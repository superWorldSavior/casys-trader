# Local secrets/config. Copy to .env; never commit the real file.
#
# Spark/acpx remains the primary brain. Ollama Cloud is the fallback when Spark
# fails with a retryable provider/quota/rate-limit/timeout error.

# Binaire acpx utilisé par le runtime (décideur). Par défaut : "acpx" (npm global).
# Pointer vers le fork buildé localement pour activer la rétention native des sessions.
# Construire avec `make fork-acpx-build` (voir Makefile).
# TRADER_ACPX_BIN=/Users/erwanpesle/Documents/GitHub/acpx/dist/cli.js

# Binaire acpx utilisé par le consolidateur de learnings. Indépendant du runtime
# pour permettre des versions/forks différents entre les deux rôles.
# TRADER_CONSOLIDATOR_ACPX_BIN=/Users/erwanpesle/Documents/GitHub/acpx/dist/cli.js

TRADER_OLLAMA_API_KEY=
TRADER_OLLAMA_BASE_URL=https://ollama.com/v1
TRADER_OLLAMA_MODEL=nemotron-3-nano:30b-cloud

# Finnhub — fil d'actu (earnings calendar + company news). Free tier: https://finnhub.io
# DORMANT : clé déclarée mais AUCUN code ne la lit (intégration jamais codée ; le
# free tier est US-only, inutile pour l'univers EU/TW). Décommenter le jour où
# l'intégration existe.
# TRADER_FINNHUB_API_KEY=

# Décideur : nb max d'appels LLM lancés en parallèle par batch (défaut code: 3).
# 1 = séquentiel. Recommandé tant que le backend gpt-5.5/Codex sature sous
# concurrence (overload app-server → provider_error → fallback sonnet).
CASYS_DECISION_BATCH_PARALLELISM=1

# Niveau des logs console (défaut INFO). DEBUG ressort le détail fetch
# par-symbole (source_skipped/source_fallback stale), sinon résumé [market]
# seul. Mettre DEBUG ponctuellement pour investiguer un souci de données.
# CASYS_LOG_LEVEL=INFO

# Tournée d'outils domaine pour le LLM runtime (design 2026-06-29).
# 0 (défaut) = comportement historique ; 1 = le LLM peut demander UNE tournée
# d'outils lecture-seule (get_freshness, get_active_plans, ...) avant de décider.
CASYS_AGENT_TOOLS_ENABLED=0

# Clé OpenAI — embeddings recall (text-embedding-3-small, store learnings).
# Utilisée par scripts/learnings_ingest.py (backfill) et par le daemon pour
# embedder les requêtes recall_learnings à la volée.
# OPENAI_API_KEY=sk-...
