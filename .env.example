# Local secrets/config. Copy to .env; never commit the real file.
#
# Spark/acpx remains the primary brain. Ollama Cloud is the fallback when Spark
# fails with a retryable provider/quota/rate-limit/timeout error.

# Binaire acpx utilisé par le runtime (décideur). Par défaut : "acpx" (npm global).
# Pointer vers le fork buildé localement pour activer la rétention native des sessions.
# Construire avec `make fork-acpx-build` (voir Makefile).
# TRADER_ACPX_BIN=/absolute/path/to/acpx/dist/cli.js

# Binaire acpx utilisé par le consolidateur de learnings. Indépendant du runtime
# pour permettre des versions/forks différents entre les deux rôles.
# TRADER_CONSOLIDATOR_ACPX_BIN=/absolute/path/to/acpx/dist/cli.js

# Brain trader (décideur par symbole) : adaptateur ACP et modèle. Défaut : agent
# acpx global (codex) + "gpt-5.6-terra". Se déclare en PAIRE : l'agent doit
# annoncer le modèle (ex. Kimi : TRADER_ACPX_AGENT=kimi et
# TRADER_MODEL=kimi-code/kimi-for-coding). Ne s'applique qu'au profil trader par
# défaut — un agent/modèle explicite au builder (rotation, universe) prime.
# Les agents analystes ont leurs knobs dédiés : TRADER_CONSOLIDATOR_ACPX_AGENT /
# TRADER_CONSOLIDATOR_MODEL, TRADER_UNIVERSE_ACPX_AGENT / TRADER_UNIVERSE_MODEL,
# TRADER_COMPANY_MICRO_ACPX_AGENT / TRADER_COMPANY_MICRO_MODEL,
# TRADER_NEWS_MACRO_ACPX_AGENT / TRADER_NEWS_MACRO_MODEL (l'agent macro-news
# hérite sinon du couple consolidateur — déclarer les DEUX pour éviter une
# paire agent+modèle incohérente).
# TRADER_ACPX_AGENT=
# TRADER_MODEL=
# Effort du brain appliqué à sa session via le mécanisme natif `acpx set`.
# Les analystes n'héritent pas de cette variable et restent sur le défaut du
# CODEX_HOME partagé (Sol low dans ops/codex-home/config.toml).
# TRADER_REASONING_EFFORT=medium

# Repli secondaire. `TRADER_FALLBACK_ACPX_AGENT` est un agent runtime et
# `TRADER_FALLBACK_MODEL` doit être l'id réellement annoncé par cet agent.
# Une valeur modèle vide désactive ce tier. Compatibilité :
# TRADER_SPARK_FALLBACK_MODEL reste lu si TRADER_FALLBACK_MODEL est absent,
# mais ne sélectionne pas l'agent. Autorité = ops/model-presets/*.env (ne pas
# éditer le .env live). Preset `grok` : repli Brain = Cursor CLI xhigh
# non-fast. Preset `cursor-grok` : primaire Cursor sur les cinq rôles, repli
# xAI grok-build/grok-4.6, jamais Sonnet ; Cursor reste `--mode ask` + sandbox
# même si CASYS_AGENT_EXEC=1.
# TRADER_FALLBACK_ACPX_AGENT=grok-build
# TRADER_FALLBACK_MODEL=grok-4.6

# NE PAS éditer ces paires à la main : elles vivent dans un BLOC généré du .env,
# à partir d'un preset versionné (ops/model-presets/*.env).
#   make models                            # jeu actif + preset courant
#   make model-preset PRESET=kimi          # dry-run
#   make model-preset PRESET=grok          # dry-run (brain low, reste medium)
#   make model-preset PRESET=kimi WRITE=1  # applique (redémarrer le daemon)
# cf. docs/reference/model-presets.md

# Tous les rôles Codex partagent le CODEX_HOME nu défini plus bas (Sol low par
# défaut). Seul le brain surcharge l'effort sur sa session ACP :
# TRADER_REASONING_EFFORT=medium
# cf. docs/reference/codex-home-isole.md

# Timeout de l'analyste company-micro en secondes (défaut 240). À relever (ex.
# 600) pour les modèles lents type kimi-code/k3 sur les gros evidence packs —
# le défaut les coupe avant réponse (échecs TIMEOUT en boucle dans la file).
# TRADER_COMPANY_MICRO_TIMEOUT_S=240

# Cap par-appel subprocess (défaut code 150). Le preset `cursor-grok` versionne
# 600 s : sans cette clé, xhigh est coupé et le runtime bascule vers Grok low.
# CASYS_ACPX_CALL_TIMEOUT_S=600

TRADER_OLLAMA_API_KEY=
TRADER_OLLAMA_BASE_URL=https://ollama.com/v1
TRADER_OLLAMA_MODEL=nemotron-3-nano:30b-cloud

# Finnhub — fil d'actu (earnings calendar + company news). Free tier: https://finnhub.io
# DORMANT : clé déclarée mais AUCUN code ne la lit (intégration jamais codée ; le
# free tier est US-only, inutile pour l'univers EU/TW). Décommenter le jour où
# l'intégration existe.
# TRADER_FINNHUB_API_KEY=

# SEC EDGAR public data APIs — aucune clé/token requis pour Company Facts.
# La SEC exige un User-Agent déclaré : organisation/application + email de contact.
# Remplacer l'adresse avant usage.
CASYS_SEC_USER_AGENT=Casys Trader admin@example.com

# Décideur : nb max d'appels LLM lancés en parallèle par batch (défaut code: 3).
# 1 = séquentiel. Recommandé tant que le backend gpt-5.5/Codex sature sous
# concurrence (overload app-server → provider_error → fallback sonnet).
CASYS_DECISION_BATCH_PARALLELISM=1

# Niveau des logs console (défaut INFO). DEBUG ressort le détail fetch
# par-symbole (source_skipped/source_fallback stale), sinon résumé [market]
# seul. Mettre DEBUG ponctuellement pour investiguer un souci de données.
# CASYS_LOG_LEVEL=INFO

# Tournée d'outils domaine pour le LLM runtime (design 2026-06-29).
# 0 (défaut) = comportement historique ; 1 = le LLM peut demander UNE tournée
# d'outils lecture-seule (get_freshness, get_active_plans, ...) avant de décider.
CASYS_AGENT_TOOLS_ENABLED=0

# Clé OpenAI — embeddings recall (text-embedding-3-small, store learnings).
# Utilisée par le worker automatique du daemon, scripts/learnings_ingest.py et
# les requêtes sémantiques recall_learnings à la volée.
# OPENAI_API_KEY=sk-...

# Synchronisation FLAIR/MemRL best-effort du daemon : ingestion des JSONL,
# embeddings manquants, outcomes différés et rewards de recall. Activée par
# défaut ; 0 ne désactive que la maintenance, jamais les décisions de trading.
TRADER_LEARNINGS_AUTO_SYNC_ENABLED=1

# CODEX_HOME isolé pour tous les appels ACPX de l'app : pointe vers
# ops/codex-home (config.toml nu, 0 plugin/skill/MCP) pour des sessions de
# décision déterministes (contrat JSON strict). Le transport refuse de lancer
# ACPX si model_reasoning_effort n'y vaut pas "low", quel que soit le modèle.
# auth.json y est symlinkée vers ~/.codex/auth.json. Chemin ABSOLU.
CODEX_HOME=/chemin/absolu/vers/casys-trader/ops/codex-home
