# Preset Grok officiel — switch comme kimi / codex-luna-medium.
#
# Brain trader = grok-4.6 **low** (ops/grok-home).
# Consolidateur / univers / micro / macro = grok-4.6 **medium**
# (ops/grok-home-medium). Macro/news partage le GROK_HOME du consolidateur
# (même provider `consolidator`, cf. news_macro.analyzer).
#
# L'effort Grok n'est PAS passable par appel ACP (set = -32601) : un effort
# = un GROK_HOME. GROK_HOME global = fallback benches / transport sans rôle
# (low, cran trading).
#
# Agent acpx : `grok-build` → `grok agent stdio`. Auth = login grok.com
# (symlink ops/grok-home{,-medium}/auth.json), pas de clé API.
#
# Appliquer : make model-preset PRESET=grok WRITE=1

GROK_HOME=${REPO}/ops/grok-home
TRADER_GROK_HOME=${REPO}/ops/grok-home
TRADER_CONSOLIDATOR_GROK_HOME=${REPO}/ops/grok-home-medium
TRADER_UNIVERSE_GROK_HOME=${REPO}/ops/grok-home-medium
TRADER_COMPANY_MICRO_GROK_HOME=${REPO}/ops/grok-home-medium

# Brain trader (décision) — low
TRADER_ACPX_AGENT=grok-build
TRADER_MODEL=grok-4.6
# Repli Brain seulement : Cursor CLI force Grok 4.6 xhigh non-fast. Il reste
# read-only et ne change ni le primaire ni les rôles analystes.
TRADER_FALLBACK_ACPX_AGENT=cursor
TRADER_FALLBACK_MODEL=cursor-grok-4.6-xhigh

# Consolidateur de learnings — medium
TRADER_CONSOLIDATOR_ACPX_AGENT=grok-build
TRADER_CONSOLIDATOR_MODEL=grok-4.6

# Agent univers (rotation) — medium
TRADER_UNIVERSE_ACPX_AGENT=grok-build
TRADER_UNIVERSE_MODEL=grok-4.6

# Analyste micro par société — medium
TRADER_COMPANY_MICRO_ACPX_AGENT=grok-build
TRADER_COMPANY_MICRO_MODEL=grok-4.6

# Analyste macro/news — medium via le profil du consolidateur
TRADER_NEWS_MACRO_ACPX_AGENT=grok-build
TRADER_NEWS_MACRO_MODEL=grok-4.6

# Grok medium dépasse les défauts 120/240 s (mesuré : macro 258 s, univers cut 120 s).
TRADER_NEWS_MACRO_TIMEOUT_S=600
TRADER_UNIVERSE_TIMEOUT_S=600
TRADER_COMPANY_MICRO_TIMEOUT_S=600
