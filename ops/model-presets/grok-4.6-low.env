# Preset Grok Build **tout low** — benches / debug.
# Le switch live officiel est `grok` (brain low, reste medium).
#
# 4.6 est le seul modèle Grok utile ici : même prix API que 4.5 ($2/$6),
# meilleur raisonnement. Le levier cheap/rapide n'est pas un autre modèle
# (le CLI n'annonce que 4.6 et 4.5) : c'est `default_reasoning_effort=low`.
#
# Agent acpx : `grok-build` → `grok agent stdio`. Auth = login grok.com
# (symlink ops/grok-home/auth.json), pas de clé API.
# L'effort n'est PAS passable par session ACP (set = -32601).
#
# Appliquer : make model-preset PRESET=grok-4.6-low WRITE=1

GROK_HOME=${REPO}/ops/grok-home
TRADER_GROK_HOME=${REPO}/ops/grok-home
TRADER_CONSOLIDATOR_GROK_HOME=${REPO}/ops/grok-home
TRADER_UNIVERSE_GROK_HOME=${REPO}/ops/grok-home
TRADER_COMPANY_MICRO_GROK_HOME=${REPO}/ops/grok-home

TRADER_ACPX_AGENT=grok-build
TRADER_MODEL=grok-4.6

TRADER_CONSOLIDATOR_ACPX_AGENT=grok-build
TRADER_CONSOLIDATOR_MODEL=grok-4.6

TRADER_UNIVERSE_ACPX_AGENT=grok-build
TRADER_UNIVERSE_MODEL=grok-4.6

TRADER_COMPANY_MICRO_ACPX_AGENT=grok-build
TRADER_COMPANY_MICRO_MODEL=grok-4.6

TRADER_NEWS_MACRO_ACPX_AGENT=grok-build
TRADER_NEWS_MACRO_MODEL=grok-4.6
