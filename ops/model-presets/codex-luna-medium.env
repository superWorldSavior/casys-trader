# Preset Codex actif : brain Luna medium, analystes Sol low (2026-08-10).
#
# Un seul CODEX_HOME en Sol low pour tous les rôles. Le brain ouvre une session
# Luna puis applique `reasoning_effort=medium` via ACP avant son premier prompt.
#
# Appliquer : make model-preset PRESET=codex-luna-medium WRITE=1

# Brain trader (décision) — Luna medium
TRADER_ACPX_AGENT=codex
TRADER_MODEL=gpt-5.6-luna
TRADER_REASONING_EFFORT=medium

# Consolidateur de learnings (+ macro/news pour le profil) — Sol low
TRADER_CONSOLIDATOR_ACPX_AGENT=codex
TRADER_CONSOLIDATOR_MODEL=gpt-5.6-sol

# Agent univers (rotation) — Sol low
TRADER_UNIVERSE_ACPX_AGENT=codex
TRADER_UNIVERSE_MODEL=gpt-5.6-sol

# Analyste micro par société — Sol low
TRADER_COMPANY_MICRO_ACPX_AGENT=codex
TRADER_COMPANY_MICRO_MODEL=gpt-5.6-sol

# Analyste macro/news — Sol low via le profil du consolidateur
TRADER_NEWS_MACRO_ACPX_AGENT=codex
TRADER_NEWS_MACRO_MODEL=gpt-5.6-sol
