# Preset Cursor/Grok : les cinq rôles utilisent Cursor CLI / Grok 4.6 xhigh
# non-fast. Le repli de chaque rôle Cursor est la paire xAI configurée
# (grok-build / grok-4.6 low), jamais Claude/Sonnet.
#
# Le transport appelle le sélecteur natif exact `cursor-grok-4.6-xhigh`, puis
# refuse le tour si le flux Cursor n'annonce pas « Cursor Grok 4.6 Extra High ».
# Il force `--mode ask` et le sandbox : jamais d'outils ni d'écriture, même si
# CASYS_AGENT_EXEC=1 est actif pour un autre backend. Le provider rapporté est
# `cursor-agent` ; le rôle logique reste le session_label.
#
# Appliquer : make model-preset PRESET=cursor-grok WRITE=1

GROK_HOME=${REPO}/ops/grok-home
TRADER_GROK_HOME=${REPO}/ops/grok-home

# Brain trader — Cursor CLI, sélecteur natif xhigh non-fast.
TRADER_ACPX_AGENT=cursor
TRADER_MODEL=cursor-grok-4.6-xhigh
TRADER_FALLBACK_ACPX_AGENT=grok-build
TRADER_FALLBACK_MODEL=grok-4.6

# Consolidateur / univers / micro / macro — Cursor comme le Brain.
TRADER_CONSOLIDATOR_ACPX_AGENT=cursor
TRADER_CONSOLIDATOR_MODEL=cursor-grok-4.6-xhigh
TRADER_UNIVERSE_ACPX_AGENT=cursor
TRADER_UNIVERSE_MODEL=cursor-grok-4.6-xhigh
TRADER_COMPANY_MICRO_ACPX_AGENT=cursor
TRADER_COMPANY_MICRO_MODEL=cursor-grok-4.6-xhigh
TRADER_NEWS_MACRO_ACPX_AGENT=cursor
TRADER_NEWS_MACRO_MODEL=cursor-grok-4.6-xhigh

TRADER_NEWS_MACRO_TIMEOUT_S=600
TRADER_UNIVERSE_TIMEOUT_S=600
TRADER_COMPANY_MICRO_TIMEOUT_S=600
# Cap par-appel du transport (Cursor xhigh et Grok fallback). Sans cette
# valeur, le défaut code 150 s coupe xhigh et bascule vers Grok low.
CASYS_ACPX_CALL_TIMEOUT_S=600
